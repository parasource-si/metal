# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=duskbot
DUSK_BIND_ADDRESS=127.0.0.1
DUSK_HTTP_PORT=8080
# Leave empty to use http://localhost:${DUSK_HTTP_PORT:-8080}.
DUSK_PUBLIC_URL=
# Leave empty to inherit DUSK_PUBLIC_URL.
DUSK_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set DUSK_PUBLIC_URL to https:// followed by the same hostname.
# Requires DUSK_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
DUSK_HTTPS_HOST=
DUSK_BASE_IMAGE=ghcr.io/parasource-si/metal:latest
DUSK_LOCAL_IMAGE=metal-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
DUSK_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
DUSK_DATA_EXTERNAL=false
