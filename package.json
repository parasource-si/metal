{
  "name": "metal",
  "private": true,
  "version": "0.2.23",
  "description": "A local-first chat app for running a team of AI agents.",
  "homepage": "https://github.com/parasource-si/metal",
  "repository": {
    "type": "git",
    "url": "https://github.com/parasource-si/metal.git"
  },
  "author": {
    "name": "Metal",
    "email": "hello@dusk.bot"
  },
  "license": "SEE LICENSE IN LICENSE",
  "desktopName": "bot.dusk.app.desktop",
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node scripts/install-git-hooks.mjs",
    "lint": "oxlint --deny-warnings .",
    "check:contrast": "node scripts/check-skin-contrast.mjs",
    "i18n:check": "node scripts/generate-locale.mjs --check",
    "dev": "vite",
    "mobile:preview": "node apps/mobile/scripts/phone-preview.mjs",
    "store:shots": "node --experimental-strip-types apps/mobile/store/capture.ts && node --experimental-strip-types apps/mobile/store/compose.ts",
    "test:phone-layout": "node --experimental-strip-types apps/mobile/store/layout-check.ts",
    "mobile:build":"pnpm --filter @metal/mobile build",
    "mobile:gate": "node apps/mobile/scripts/release-gate.mjs",
    "mobile:release": "pnpm --filter @metal/mobile build && node apps/mobile/scripts/release-gate.mjs && pnpm --filter @metal/mobile exec cap sync",
    "companion": "node --experimental-strip-types apps/companion/src/index.ts",
    "metal": "node --experimental-strip-types server/metal.ts",
    "dusk": "node --experimental-strip-types server/metal.ts",
    "pair": "node --experimental-strip-types server/metal.ts pair",
    "dev:server": "node --experimental-strip-types server/dev-server.ts",
    "demo": "node scripts/demo/demo.mjs",
    "test-bots": "node scripts/demo/test-bots.mjs",
    "mcp": "node --experimental-strip-types scripts/mcp-server.ts",
    "control:metal": "node --experimental-strip-types scripts/control-dusk.ts",
    "control:dusk": "node --experimental-strip-types scripts/control-dusk.ts",
    "ui:baseline": "node --experimental-strip-types scripts/testing/visual-baseline.ts",
    "dev:desktop": "node scripts/prepare-cloudflared.mjs --current && electron .",
    "dev:app": "node scripts/dev-app.mjs",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "dashboard:service": "node apps/dashboard/server/main.ts",
    "dashboard:fixture": "node apps/dashboard/scripts/fixture.ts --demo",
    "build:dashboard": "tsc -p apps/dashboard/tsconfig.json && vite build --config apps/dashboard/vite.config.ts",
    "typecheck:dashboard": "tsc -p apps/dashboard/tsconfig.json",
    "build": "tsc -b && tsc -p server/tsconfig.json && vite build",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "test": "vitest run && pnpm broker:test && pnpm test:electron && pnpm test:packaged-server",
    "test:electron": "node --test \"electron/*.node-test.mjs\"",
    "test:main": "node scripts/test-main.mjs",
    "test:accounts": "vitest run electron/accounts-e2e.test.mjs",
    "bench:observation": "node --experimental-strip-types scripts/bench-observation.ts",
    "bench:persistence": "node --experimental-strip-types scripts/bench-persistence.ts",
    "bench:today": "node --experimental-strip-types scripts/bench-today.ts",
    "bench:browser-stream": "node --experimental-strip-types scripts/bench-browser-stream.ts",
    "bench:desktop": "node --experimental-strip-types scripts/bench-desktop.ts",
    "bench:switching": "node --experimental-strip-types scripts/bench-switching.ts",
    "test:watch": "vitest",
    "test:cua": "pnpm build:cua && node scripts/smoke-cua.mjs",
    "test:cua-container": "node scripts/smoke-cua-container.mjs",
    "check:electron": "node scripts/check-electron.mjs",
    "preview": "vite preview",
    "build:server": "node scripts/clean-server-build.mjs && tsc -p server/tsconfig.build.json && node scripts/bundle-server.mjs",
    "build:companion": "tsc -p apps/companion/tsconfig.build.json --noEmit && node scripts/bundle-companion.mjs && node scripts/mark-module-scope.mjs dist-companion",
    "build:speech": "node electron/build-speech-helper.mjs",
    "build:cua": "node scripts/prepare-cua.mjs",
    "build:cua:win": "node scripts/prepare-cua-win.mjs",
    "smoke:cua-win": "node scripts/smoke-cua-win-embedded.mjs",
    "build:android-tools": "node scripts/prepare-android-tools.mjs",
    "build:cloudflared": "node scripts/prepare-cloudflared.mjs",
    "build:browser": "node scripts/prepare-browser.mjs",
    "build:duckdb": "node scripts/prepare-duckdb.mjs",
    "smoke:browser": "node scripts/smoke-browser-bundle.mjs",
    "build:cua:linux": "node scripts/prepare-cua-linux.mjs",
    "build:cua:linux:offline": "node scripts/prepare-cua-linux.mjs --offline",
    "build:ssh2": "node scripts/bundle-ssh2.mjs",
    "package:prepare": "pnpm build && node scripts/bundle-cloud-seal.mjs && pnpm build:server && pnpm build:companion && pnpm build:android-tools && pnpm build:cloudflared && pnpm build:browser && pnpm build:duckdb",
    "package:mac": "pnpm package:prepare && pnpm build:speech && pnpm build:cua && node scripts/pack-browser-part.mjs && electron-builder --config build/electron-builder.yml --mac --publish never",
    "package:win": "pnpm package:prepare && pnpm build:cua:win && electron-builder --config build/electron-builder.yml --win --publish never",
    "package:win:cross": "pnpm package:prepare && node scripts/stage-win-cross.mjs && electron-builder --config build/electron-builder.yml --win --x64 --publish never",
    "package:linux": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --config build/electron-builder.yml --linux --x64 --publish never -c.productName=dusk-bot",
    "package:linux:offline": "pnpm package:prepare && pnpm build:cua:linux:offline && electron-builder --config build/electron-builder.yml --linux --x64 --publish never -c.productName=dusk-bot",
    "smoke:deb-command": "node scripts/smoke-deb-command.mjs",
    "smoke:linux-package": "node scripts/run-linux-package-smoke.mjs",
    "smoke:cua-x11-input": "node scripts/smoke-cua-x11-input.mjs",
    "package:linux:dir": "pnpm package:prepare && pnpm build:cua:linux && electron-builder --config build/electron-builder.yml --linux dir --x64 --publish never -c.productName=dusk-bot",
    "package": "pnpm package:mac",
    "test:packaged-server": "pnpm build:server && node scripts/smoke-packaged-server.mjs",
    "broker:types": "wrangler types --config apps/cloudflare/composio-broker/wrangler.jsonc apps/cloudflare/composio-broker/worker-configuration.d.ts",
    "broker:check": "pnpm broker:types && tsc -p apps/cloudflare/composio-broker/tsconfig.json",
    "broker:test": "vitest run --config apps/cloudflare/composio-broker/vitest.config.ts",
    "broker:deploy": "wrangler deploy --config apps/cloudflare/composio-broker/wrangler.jsonc",
    "relay:test": "vitest run --config apps/cloudflare/link-relay/vitest.config.ts",
    "relay:e2e": "RELAY_E2E=1 vitest run --config apps/cloudflare/link-relay/vitest.config.ts test/e2e.test.js"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@clack/prompts": "1.7.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hpke/core": "1.9.0",
    "@muse-code/sdk": "1.4.6",
    "@novnc/novnc": "1.7.0",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-virtual": "^3.14.13",
    "@trycua/cua-driver": "0.28.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "clsx": "^2.1.1",
    "croner": "10.0.1",
    "imapflow": "2.10.0",
    "jmespath": "0.16.0",
    "jose": "6.2.10",
    "katex": "^0.16.47",
    "mailparser": "3.14.1",
    "mdast-util-from-markdown": "^2.0.3",
    "mermaid": "^12.1.0",
    "mongodb": "^6.22.0",
    "motion": "^14.9.1",
    "node-datachannel": "0.33.6",
    "nodemailer": "10.3.1",
    "onnxruntime-node": "1.31.1",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.5.438",
    "qrcode-terminal": "0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sucrase": "3.35.1",
    "tailwind-merge": "^3.3.1",
    "tar": "7.5.22",
    "tldts": "7.4.18",
    "undici": "8.12.2",
    "vega": "6.4.0",
    "vega-embed": "7.3.0",
    "vega-interpreter": "2.3.2",
    "vega-lite": "6.5.0",
    "ws": "8.22.0",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@tailwindcss/vite": "^4.1.11",
    "@types/jmespath": "0.15.2",
    "@types/node": "^26.2.0",
    "@types/novnc__novnc": "1.6.0",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode-terminal": "0.12.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.8.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "lucide-react": "^0.539.0",
    "oxlint": "1.80.0",
    "ssh2": "1.17.0",
    "tailwindcss": "^4.1.11",
    "typebox": "1.3.7",
    "typescript": "^5.8.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "4.123.0"
  }
}
