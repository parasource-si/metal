{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "duskbot-composio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  // the upstream Dusk Bot Cloudflare account (the dusk.bot zone): scripts/deploy-composio-broker.sh creates the database,
  // writes its id below, applies the migrations, sets the secrets and deploys
  "workers_dev": false,
  "routes": [{ "pattern": "composio.dusk.bot", "custom_domain": true }, { "pattern": "composio.dusk.bot/*", "zone_name": "dusk.bot" }],
  "vars": {
    "COMPOSIO_API_BASE": "https://backend.composio.dev/api/v3.1",
    "COMPOSIO_TOOLKIT_BASE": "https://backend.composio.dev/api/v3",
    // the upstream project pays nothing per tool call: no new installations, and the test installations that exist stay inside
    // composio's free allowance
    "REGISTRATION_MODE": "closed",
    "GLOBAL_DAILY_TOOL_CALLS": "500"
  },
  "secrets": { "required": ["COMPOSIO_API_KEY"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "duskbot-composio",
      "database_id": "284c79d9-d1b6-406f-b08b-eb7d1abd1ac6",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "REGISTRATION_LIMITER", "namespace_id": "8261701", "simple": { "limit": 30, "period": 60 } },
    { "name": "SESSION_LIMITER", "namespace_id": "8261702", "simple": { "limit": 600, "period": 60 } },
    { "name": "EVENTS_LIMITER", "namespace_id": "8261703", "simple": { "limit": 300, "period": 60 } }
  ],
  // Hourly: expire app events older than 7 days, pause the triggers of installations idle for 14 days.
  "triggers": { "crons": ["23 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
