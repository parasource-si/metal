[Unit]
Description=Metal host report to the ops page
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# DUSK_OPS_REPORT_URL, DUSK_OPS_REPORT_TOKEN, DUSK_HOST_NAME; root-owned, mode 0600
EnvironmentFile=/etc/dusk-host-report.env
ExecStart=/usr/bin/node /opt/dusk-uptime/host-report.mjs
TimeoutStartSec=60
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/srv/dusk-backups
