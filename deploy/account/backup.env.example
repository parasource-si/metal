# /etc/dusk-backup/<set>.env on the vps, root-owned, mode 0600; one file per set, run by dusk-backup@<set>.timer.
# every name is described at the top of backup.sh.

# Metal (/etc/dusk-backup/dusk.env), every 6 hours (dusk-backup@dusk.timer.d): both account databases and the waitlist (one dump of mongod-dusk), both
# account data folders and the link service's state. preview's sealed test-cloud backups and old link builds stay out.
DUSK_BACKUP_NAME=dusk
DUSK_BACKUP_PATHS="/var/lib/dusk-account-prod /var/lib/dusk-account-preview /root/omb-link-data"
DUSK_BACKUP_EXCLUDE="/var/lib/dusk-account-preview/managed-backups/ *.prev /root/omb-link-data/packages/*.tgz /var/lib/dusk-account-prod/managed-backups/ omb-home*.tgz*"
DUSK_BACKUP_MONGO_CONFIG=/etc/mongod-dusk/backup.yaml
DUSK_BACKUP_RECIPIENT=age1...
DUSK_BACKUP_DEST="oracle-backup:/data r2-backup:dusk-backups"
DUSK_BACKUP_KEEP_RUNS=8
DUSK_BACKUP_KEEP_DAYS=7
DUSK_BACKUP_KEEP_WEEKS=4
# the cloud packages (omb-home*.tgz, rebuilt by every release) and the clouds' own backups stay out: about 20 archives of a few MB; r2's 10 GB free tier is shared with make.design's uploads

# make.design, once a day (/etc/dusk-backup/make.env): its database only (uploads already live in its own r2 bucket).
# /etc/dusk-backup/make-mongo.yaml holds one line, uri: <make's MONGODB_URI>; mongodump only reads.
# DUSK_BACKUP_NAME=make
# DUSK_BACKUP_MONGO_CONFIG=/etc/dusk-backup/make-mongo.yaml
